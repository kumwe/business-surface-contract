{
  "name": "kumwe/business-surface-contract",
  "description": "Portable custom business action, view and field presentation contracts.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/business-surface-contract",
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "kumwe/access-context": "0.1.0",
    "kumwe/contribution": "0.1.0",
    "kumwe/conversion": "0.1.0",
    "kumwe/canonical-json": "0.1.1",
    "kumwe/idempotency": "dev-main || dev-fix/normal-recorded-publication",
    "kumwe/record-model": "dev-main || dev-fix/stable-definition-dependency",
    "kumwe/record-query": "dev-main || dev-fix/stable-definition-dependency",
    "kumwe/record-values": "dev-main",
    "kumwe/business-definition": "0.1.0",
    "kumwe/sequence": "0.2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\BusinessSurface\\Contract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\BusinessSurface\\Contract\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-progress",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "api": "php tools/public-api.php",
    "api:record": "php tools/public-api.php --write",
    "architecture": "php tools/architecture.php",
    "examples": "php examples/standalone.php",
    "security": "composer audit --abandoned=fail",
    "clean-consumer": "php tools/clean-consumer.php",
    "check": [
      "@composer:validate",
      "@lint",
      "@api",
      "@architecture",
      "@analyse",
      "@cs",
      "@test",
      "@examples",
      "@security",
      "@clean-consumer"
    ],
    "composer:validate": "composer validate --strict"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.git",
      "/.github",
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpunit.xml",
      "/phpstan.neon",
      "/phpcs.xml",
      "/tools",
      "/.phpunit.cache",
      "/.phpstan-cache"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/canonical-json"
    },
    {
      "type": "git",
      "url": "https://github.com/kumwe/idempotency"
    },
    {
      "type": "git",
      "url": "https://github.com/kumwe/record-model"
    },
    {
      "type": "git",
      "url": "https://github.com/kumwe/record-query"
    },
    {
      "type": "git",
      "url": "https://github.com/kumwe/record-values"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/business-definition.git"
    },
    {
      "type": "vcs",
      "url": "https://github.com/kumwe/sequence.git"
    }
  ]
}
