{
  "name": "kumwe/business-surface-contract",
  "description": "Portable custom business action, view and field presentation contracts.",
  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/kumwe/business-surface-contract",
  "require": {
    "php": "^8.5",
    "ext-mbstring": "*",
    "kumwe/access-context": "0.1.2",
    "kumwe/contribution": "0.1.1",
    "kumwe/conversion": "0.1.5",
    "kumwe/canonical-json": "0.1.1",
    "kumwe/idempotency": "0.1.2",
    "kumwe/record-model": "0.1.3",
    "kumwe/record-query": "0.1.3",
    "kumwe/record-values": "0.1.4"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "phpstan/phpstan": "^2.1",
    "squizlabs/php_codesniffer": "^4.0",
    "ext-zip": "*",
    "phpstan/phpstan-strict-rules": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "Kumwe\\BusinessSurface\\Contract\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Kumwe\\BusinessSurface\\Contract\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --no-progress",
    "lint": "php tools/lint.php",
    "analyse": "phpstan analyse --no-progress --memory-limit=1G",
    "cs": "phpcs -q",
    "cs:fix": "phpcbf",
    "api": "php tools/public-api.php",
    "api:record": "php tools/public-api.php --write",
    "architecture": "php tools/architecture.php",
    "examples": "php examples/standalone.php",
    "security": "composer audit --abandoned=fail",
    "clean-consumer": "php tools/clean-consumer.php",
    "check": [
      "@composer:validate",
      "@schemas",
      "@dependencies:check",
      "@lint",
      "@api",
      "@manifests",
      "@architecture",
      "@analyse",
      "@cs",
      "@test",
      "@examples",
      "@security",
      "@clean-consumer"
    ],
    "composer:validate": "composer validate --strict",
    "manifests": "php tools/verify-governed-manifests.php",
    "dependencies:check": [
      "bash tools/check-dependency-readiness.sh",
      "bash tools/test-dependency-readiness.sh"
    ],
    "schemas": "node tools/schema-validator/verify.cjs"
  },
  "config": {
    "sort-packages": true
  },
  "archive": {
    "exclude": [
      "/.git",
      "/.github",
      "/tests",
      "/vendor",
      "/composer.lock",
      "/phpunit.xml",
      "/phpstan.neon",
      "/phpcs.xml",
      "/tools",
      "/.phpunit.cache",
      "/.phpstan-cache"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
